KALSHI_ENV=prod
# Same credential names as Football-Bot.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
KALSHI_PRIVATE_KEY_B64=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_SUBACCOUNT=0
# Optional endpoint overrides. Defaults use Kalshi's current dedicated production endpoints.
KALSHI_REST=
KALSHI_WS=

# Safety switch. false = dashboard works but stops simulate only.
EXECUTION_ENABLED=false

DASHBOARD_PASSWORD=change-this-long-password
COOKIE_SECRET=change-this-to-another-long-random-string
COOKIE_SECURE=true
DATA_DIR=/data
