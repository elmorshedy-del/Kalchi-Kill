# Start in demo. Switch to prod only after testing.
KALSHI_ENV=demo
KALSHI_KEY_ID=
# Paste the PEM directly in Railway, OR use KALSHI_PRIVATE_KEY_B64.
KALSHI_PRIVATE_KEY=
KALSHI_PRIVATE_KEY_B64=
KALSHI_SUBACCOUNT=0

# Safety switch. false = dashboard works but stops simulate only.
EXECUTION_ENABLED=false

# Required before exposing the dashboard publicly.
DASHBOARD_PASSWORD=change-this-long-password
COOKIE_SECRET=change-this-to-another-long-random-string
COOKIE_SECURE=true

# Railway persistent volume mount recommended: /data
DATA_DIR=/data
